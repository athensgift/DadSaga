        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discard the changes you just made?"
          }
        }
      }
    },
    "Everything will be deleted from this iPhone: your family and hero, every quest, boss and moment with their notes and photos, your wardrobe and the weekly reminder. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα διαγραφούν όλα από αυτό το iPhone: η οικογένεια και ο ήρωάς σου, κάθε αποστολή, αφεντικό και στιγμή με τις σημειώσεις και τις φωτογραφίες τους, η ντουλάπα και η εβδομαδιαία υπενθύμιση. Δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything will be deleted from this iPhone: your family and hero, every quest, boss and moment with their notes and photos, your wardrobe and the weekly reminder. This can't be undone."
          }
        }
      }
    },
