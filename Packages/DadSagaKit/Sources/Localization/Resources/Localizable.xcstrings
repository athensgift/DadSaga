    },
    "Deletes everything on this iPhone and opens the first screen again." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει τα πάντα σε αυτό το iPhone και ανοίγει ξανά την πρώτη οθόνη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
