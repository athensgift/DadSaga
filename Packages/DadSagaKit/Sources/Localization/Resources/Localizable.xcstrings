    "DadSaga feedback" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχόλια για το DadSaga"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DadSaga feedback"
          }
        }
      }
    },
    "DadSaga has no account and no tracking. Your family, quests, moments and photos stay on this iPhone, and in its backups if you make them." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DadSaga δεν έχει λογαριασμό ούτε παρακολούθηση. Η οικογένεια, οι αποστολές, οι στιγμές και οι φωτογραφίες σου μένουν σε αυτό το iPhone, και στα αντίγραφα ασφαλείας του αν τα κρατάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DadSaga has no account and no tracking. Your family, quests, moments and photos stay on this iPhone, and in its backups if you make them."
          }
        }
      }
    },
    "DadSaga turns the first years of fatherhood into a game. You're the hero, your kid is your companion." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DadSaga κάνει τα πρώτα χρόνια της πατρότητας παιχνίδι. Εσύ είσαι ο ήρωας και το παιδί σου ο σύντροφός σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DadSaga turns the first years of fatherhood into a game. You're the hero, your kid is your companion."
          }
        }
      }
    },
    "Delete everything" : {
      "extractionState" : "manual",
      "localizations" : {
