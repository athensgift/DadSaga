    "DadSaga feedback" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχόλια για το DadSaga"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DadSaga feedback"
          }
        }
      }
    },
    "DadSaga has no account and no tracking. Your family, quests, moments and photos stay on this iPhone, in its backups if you make them, and in any copy of your saga you make." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DadSaga δεν έχει λογαριασμό ούτε παρακολούθηση. Η οικογένεια, οι αποστολές, οι στιγμές και οι φωτογραφίες σου μένουν σε αυτό το iPhone, στα αντίγραφα ασφαλείας του αν τα κρατάς, και σε όποιο αντίγραφο της ιστορίας σου φτιάξεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DadSaga has no account and no tracking. Your family, quests, moments and photos stay on this iPhone, in its backups if you make them, and in any copy of your saga you make."
          }
        }
      }
    },
    "DadSaga turns the first years of fatherhood into a game. You're the hero, your kid is your companion." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DadSaga κάνει τα πρώτα χρόνια της πατρότητας παιχνίδι. Εσύ είσαι ο ήρωας και το παιδί σου ο σύντροφός σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DadSaga turns the first years of fatherhood into a game. You're the hero, your kid is your companion."
          }
        }
      }
    },
    "Delete everything" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγραφή όλων"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete everything"
          }
        }
      }
    },
    "Deletes everything on this iPhone and opens the first screen again." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει τα πάντα σε αυτό το iPhone και ανοίγει ξανά την πρώτη οθόνη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes everything on this iPhone and opens the first screen again."
          }
        }
      }
    },
    "Discard" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να φύγουν"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discard"
          }
        }
      }
    },
    "Discard the changes you just made?" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να φύγουν οι αλλαγές που έκανες;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discard the changes you just made?"
          }
        }
      }
    },
    "Everything on this iPhone now will be replaced by what's in the copy: your family and hero, your title and wardrobe, every quest, boss and moment with their notes and photos. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι υπάρχει τώρα σε αυτό το iPhone θα αντικατασταθεί από όσα έχει το αντίγραφο: η οικογένεια και ο ήρωάς σου, ο τίτλος και η ντουλάπα σου, κάθε αποστολή, αφεντικό και στιγμή με τις σημειώσεις και τις φωτογραφίες τους. Δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything on this iPhone now will be replaced by what's in the copy: your family and hero, your title and wardrobe, every quest, boss and moment with their notes and photos. This can't be undone."
          }
        }
      }
    },
    "Everything will be deleted from this iPhone: your family and hero, every quest, boss and moment with their notes and photos, your wardrobe and the weekly reminder. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα διαγραφούν όλα από αυτό το iPhone: η οικογένεια και ο ήρωάς σου, κάθε αποστολή, αφεντικό και στιγμή με τις σημειώσεις και τις φωτογραφίες τους, η ντουλάπα και η εβδομαδιαία υπενθύμιση. Δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything will be deleted from this iPhone: your family and hero, every quest, boss and moment with their notes and photos, your wardrobe and the weekly reminder. This can't be undone."
          }
        }
      }
    },
